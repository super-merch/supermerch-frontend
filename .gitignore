# -----------------------------------------
# React / Node.js .gitignore (Full)
# -----------------------------------------

# Dependencies
/node_modules/

# Build output
# /dist/
# /build/
/.next/
/out/

# Production bundles
*.bundle.*
*.map

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.log
logs/
*.log

# Environment Variables
.env
.env.*
!.env.example

# Local development settings
/.env.local
/.env.development.local
/.env.test.local
/.env.production.local

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS-generated files
.DS_Store
Thumbs.db

# Cache
/.cache/
/.cache-loader/
/.eslintcache
.parcel-cache/
vite.config.*
.vite/

# Coverage
/coverage/

# Misc
*.pem
*.p12
*.key
*.crt
*.pid
*.seed
*.watchmanconfig

# Storybook
/storybook-static/

# Typescript
*.tsbuildinfo

# NPM package files
package-lock.json
yarn.lock
pnpm-lock.yaml

# Optional: Ignore lockfiles if using a team
# Uncomment ONLY if the team intentionally avoids lockfiles
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
# Category Finder generator: raw, transient per-value-count catalogue audit --
# never committed (see scripts/category-finder/fetch-catalogue-snapshot.mjs).
# Only the compact, aggregate outputs (categoryFinderManifest.js,
# parentGroupManifest.js, reconciliation.js, authoritative-category-ids.json)
# are committed.
scripts/category-finder/.snapshot/
.verify-logs/
# Full per-option live-verification evidence (URLs, per-option pass/fail,
# sample product ids) -- regenerate with verify-filter-mappings.mjs. The
# compact, committed companion is scripts/category-finder/verification-summary.json.
scripts/category-finder/.evidence/
# SSR shell copy written by scripts/prepare-vercel-shell.mjs during the
# Vercel-only "vercel-build" script. Regenerated on every deploy. Committed
# here as a fallback so Vercel can serve it even if the build step is skipped.
# /server-assets/
